/**
 * Motor principal de HACKLINE: 0xFFFF.
 * - Lectura no bloqueante de teclado.
 * - Scrolling continuo del bus de datos via Memory.poke directo.
 * - Marcador dinamico y multiplicador de combo por ciclos.
 */
class HacklineGame {
    field int lastHDir;
    field int hHold;
    field int lastVDir;
    field int vHold;
    field String strAir;
    field String strReady;
    field Player player;
    field Disc disc;
    field Array enemies;
    field int numEnemies;
    field int score;
    field int combo;
    field int comboTimer;
    field int scrollOffset;
    field int frameCount;
    field boolean gameOver;

    constructor HacklineGame new() {
        var int i;
        do Screen.clearScreen();
        let lastHDir = 0;
        let hHold = 0;
        let lastVDir = 0;
        let vHold = 0;
        let player = Player.new(240, 200);
        let disc = Disc.new();
        let numEnemies = 4;
        let enemies = Array.new(numEnemies);

        let i = 0;
        while (i < numEnemies) {
            let enemies[i] = Enemy.new(160 + (i * 48), 24 + (i * 22), i + 1);
            let i = i + 1;
        }

        let score = 0;
        let combo = 1;
        let comboTimer = 0;
        let scrollOffset = 0;
        let frameCount = 0;
        let gameOver = false;
        let strAir = "EN AIRE ";
        let strReady = "LISTO   ";
        do drawStaticHUD();
        return this;
        do drawStaticHUD();
        return this;
    }

    /** Método auxiliar: imprime un String literal y libera su memoria al instante */
    method void printAndDispose(String s) {
        do Output.printString(s);
        do s.dispose();
        return;
    }

    /** Dibuja las etiquetas estáticas liberando los Strings tras imprimirlos */
    method void drawStaticHUD() {
        var int addr;
        let addr = 16384 + (14 * 32) + 8;
        while (addr < (16384 + (14 * 32) + 24)) {
            do Memory.poke(addr, -1);
            let addr = addr + 1;
        }

        do Output.moveCursor(0, 1);
        do printAndDispose("SCORE:");
        do Output.moveCursor(0, 16);
        do printAndDispose("COMBO: x");
        do Output.moveCursor(0, 30);
        do printAndDispose("DISCO:");
        return;
    }

    /** Actualiza el HUD con CERO asignaciones en el Heap */
    method void updateHUD() {
        do Output.moveCursor(0, 8);
        do Output.printInt(score);
        do Output.printChar(32);
        do Output.printChar(32);
        do Output.printChar(32);

        do Output.moveCursor(0, 24);
        do Output.printInt(combo);
        do Output.printChar(32);

        do Output.moveCursor(0, 37);
        if (disc.isActive()) {
            do Output.printString(strAir);
        } else {
            do Output.printString(strReady);
        }
        return;
    }

    /**
     * Desplazamiento visual continuo en memoria de video (VRAM).
     * Escribe directamente en las columnas 8 (x=128..143) y 23 (x=368..383)
     * para simular avance a alta velocidad por el bus de datos.
     */
    method void updateScrollingBus() {
        var int y, rowBase, pattern, phase;

        let scrollOffset = scrollOffset + 2;
        if (scrollOffset > 15) {
            let scrollOffset = 0;
        }

        let y = 16;
        while (y < 256) {
            let rowBase = 16384 + (y * 32);
            let phase = (y - scrollOffset) & 15;

            if (phase < 4) {
                // Marcas horizontales del bus desplazandose hacia abajo
                let pattern = -1;
            } else {
                // Rieles laterales del bus de datos
                let pattern = 12291; // Binario: 0011000000000011
            }

            do Memory.poke(rowBase + 8, pattern);
            do Memory.poke(rowBase + 23, pattern);
            let y = y + 1;
        }
        return;
    }

    /** Procesa movimiento en 8 direcciones (combinacion WASD/Flechas o teclas Q/E/Z/C) */
    method void handleInput() {
        var char key;
        var int dx, dy;
        var boolean diagonalKey;

        let key = Keyboard.keyPressed();
        let dx = 0;
        let dy = 0;
        let diagonalKey = false;

        // 1. Teclas diagonales directas (evitan limite de 1 tecla en RAM[24576])
        // Q (81/113): Arriba-Izquierda
        if ((key = 81) | (key = 113)) {
            let dx = -3;
            let dy = -3;
            let diagonalKey = true;
        }
        // E (69/101): Arriba-Derecha
        if ((key = 69) | (key = 101)) {
            let dx = 3;
            let dy = -3;
            let diagonalKey = true;
        }
        // Z (90/122): Abajo-Izquierda
        if ((key = 90) | (key = 122)) {
            let dx = -3;
            let dy = 3;
            let diagonalKey = true;
        }
        // C (67/99): Abajo-Derecha
        if ((key = 67) | (key = 99)) {
            let dx = 3;
            let dy = 3;
            let diagonalKey = true;
        }

        if (diagonalKey) {
            let hHold = 0;
            let vHold = 0;
        } else {
            // 2. Lectura cardinal + buffer de combinacion simultanea (ej. W+D, S+A)
            // Arriba: W (87), w (119), Flecha Arriba (131)
            if ((key = 87) | (key = 119) | (key = 131)) {
                let lastVDir = -1;
                let vHold = 4;
            }
            // Abajo: S (83), s (115), Flecha Abajo (133)
            if ((key = 83) | (key = 115) | (key = 133)) {
                let lastVDir = 1;
                let vHold = 4;
            }
            // Izquierda: A (65), a (97), Flecha Izquierda (130)
            if ((key = 65) | (key = 97) | (key = 130)) {
                let lastHDir = -1;
                let hHold = 4;
            }
            // Derecha: D (68), d (100), Flecha Derecha (132)
            if ((key = 68) | (key = 100) | (key = 132)) {
                let lastHDir = 1;
                let hHold = 4;
            }

            if ((hHold > 0) & (vHold > 0)) {
                // Movimiento diagonal combinado
                let dx = lastHDir * 3;
                let dy = lastVDir * 3;
            } else {
                // Movimiento recto en un solo eje
                if (hHold > 0) {
                    let dx = lastHDir * 4;
                }
                if (vHold > 0) {
                    let dy = lastVDir * 4;
                }
            }

            if (hHold > 0) { let hHold = hHold - 1; }
            if (vHold > 0) { let vHold = vHold - 1; }
        }

        if ((~(dx = 0)) | (~(dy = 0))) {
            do player.move(dx, dy);
        }

        // ESPACIO (32): Lanza el Disco en la ultima direccion de movimiento
        if ((key = 32) & (~(disc.isActive()))) {
            do disc.launch(player.getX(), player.getY(), player.getAimX(), player.getAimY());
        }
        return;
    }

    /** Bucle principal de ejecucion */
    method void run() {
        var int i;
        var Enemy enemy;
        var char key;

        while (~gameOver) {
            let frameCount = frameCount + 1;

            // 1. Actualizar entorno dinamico (Scrolling en VRAM)
            do updateScrollingBus();

            // 2. Leer teclado sin bloquear
            do handleInput();

            // 3. Actualizar fisica del Disco de Puntero
            if (disc.isActive()) {
                do disc.update();
            }

            // 4. Actualizar enemigos y verificar colisiones
            let i = 0;
            while (i < numEnemies) {
                let enemy = enemies[i];
                do enemy.update(player.getX(), player.getY(), frameCount);

                // Colision Disco -> Enemigo (Eliminacion)
                if (disc.isActive()) {
                    if (MathUtils.checkCollision(disc.getX(), disc.getY(), 10, enemy.getX(), enemy.getY(), 14)) {
                        do enemy.respawn(150 + MathUtils.nextRand(190), 18);
                        let score = score + (100 * combo);
                        let combo = combo + 1;
                        let comboTimer = 110; // Ventana de tiempo para encadenar combo
                    }
                }

                // Colision Enemigo -> Jugador (Muerte de un solo impacto)
                if (MathUtils.checkCollision(player.getX(), player.getY(), 11, enemy.getX(), enemy.getY(), 11)) {
                    let gameOver = true;
                }

                let i = i + 1;
            }

            // 5. Gestionar temporizador de combo
            if (comboTimer > 0) {
                let comboTimer = comboTimer - 1;
                if (comboTimer = 0) {
                    let combo = 1;
                }
            }

            // 6. Renderizar entidades y marcador
            do player.draw();
            if (disc.isActive()) {
                do disc.draw();
            }
            do updateHUD();

            do Sys.wait(16);
        }

        // Pantalla de Game Over con reinicio instantáneo (R = 82, r = 114)
        do Output.moveCursor(11, 18);
        do printAndDispose("== PROCESO TERMINADO ==");
        do Output.moveCursor(13, 20);
        do printAndDispose("PUNTAJE FINAL: ");
        do Output.printInt(score);
        do Output.moveCursor(15, 16);
        do printAndDispose("PRESIONA ESPACIO (A) PARA REINICIAR");

        let key = 0;
        while (~(key = 32)) {
            let key = Keyboard.keyPressed();
        }
        while (Keyboard.keyPressed() = 32) {
            do Sys.wait(5);
        }
        return;
    }

    method void dispose() {
        var int i;
        var Enemy enemy;

        do player.dispose();
        do disc.dispose();
        do strAir.dispose();
        do strReady.dispose();

        let i = 0;
        while (i < numEnemies) {
            let enemy = enemies[i];
            do enemy.dispose();
            let i = i + 1;
        }
        do enemies.dispose();
        do Memory.deAlloc(this);
        return;
    }
}