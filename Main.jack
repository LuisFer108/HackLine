/**
 * Punto de entrada de HACKLINE: 0xFFFF.
 * Gestiona el ciclo de vida de las partidas y el reinicio rapido.
 */
class Main {
    function void printAndDispose(String s) {
        do Output.printString(s);
        do s.dispose();
        return;
    }

    function void main() {
        var HacklineGame game;
        var char key;
        var boolean exit;

        do MathUtils.init();
        let exit = false;

        while (~exit) {
            do Screen.clearScreen();
            do Output.moveCursor(7, 23);
            do Main.printAndDispose("HACKLINE: 0xFFFF");
            do Output.moveCursor(9, 17);
            do Main.printAndDispose("PURGA DE PROCESOS CORRUPTOS");
            do Output.moveCursor(12, 16);
            do Main.printAndDispose("MOVER: WASD / QEZC (DIAGONAL) O (JOYSTICK)");
            do Output.moveCursor(13, 16);
            do Main.printAndDispose("LANZAR DISCO: ESPACIO (A)");
            do Output.moveCursor(14, 16);
            do Main.printAndDispose("UN GOLPE MATA. ENCADENA COMBOS.");
            do Output.moveCursor(17, 18);
            do Main.printAndDispose("PRESIONA ESPACIO (A) PARA INICIAR");

            let key = 0;
            while (~(key = 32)) {
                let key = Keyboard.keyPressed();
            }
            while (Keyboard.keyPressed() = 32) {
                do Sys.wait(5);
            }

            let game = HacklineGame.new();
            do game.run();
            do game.dispose();
        }
        return;
    }
}