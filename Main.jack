/**
 * Punto de entrada de HACKLINE: 0xFFFF.
 * Gestiona el ciclo de vida de las partidas y el reinicio rapido.
 */
class Main {
    function void main() {
        var HacklineGame game;
        var char key;
        var boolean exit;

        do MathUtils.init();
        let exit = false;

        while (~exit) {
            do Screen.clearScreen();
            do Output.moveCursor(7, 23);
            do Output.printString("HACKLINE: 0xFFFF");
            do Output.moveCursor(9, 17);
            do Output.printString("PURGA DE PROCESOS CORRUPTOS");
            do Output.moveCursor(12, 16);
            do Output.printString("MOVER: WASD / FLECHAS");
            do Output.moveCursor(13, 16);
            do Output.printString("LANZAR DISCO: ESPACIO");
            do Output.moveCursor(14, 16);
            do Output.printString("UN GOLPE MATA. ENCADENA COMBOS.");
            do Output.moveCursor(17, 18);
            do Output.printString("PRESIONA ESPACIO PARA INICIAR");

            // Espera activa hasta presionar ESPACIO (32)
            let key = 0;
            while (~(key = 32)) {
                let key = Keyboard.keyPressed();
            }
            // Evitar que el disparo inicial se active inmediatamente
            while (Keyboard.keyPressed() = 32) {
                do Sys.wait(5);
            }

            let game = HacklineGame.new();
            do game.run();
            do game.dispose();
        }
        return;
    }
}